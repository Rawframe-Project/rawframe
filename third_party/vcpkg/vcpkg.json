{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/2026-07-13/docs/vcpkg.schema.json",
  "name": "rawframe-repository-tools",
  "version-string": "0.1.0",
  "dependencies": [
    {
      "name": "gtest",
      "default-features": false
    },
    {
      "name": "openssl",
      "default-features": false
    },
    {
      "name": "simdjson",
      "default-features": false,
      "features": ["utf8-validation"]
    }
  ],
  "overrides": [
    { "name": "gtest", "version": "1.17.0", "port-version": 2 },
    { "name": "openssl", "version": "3.5.7" },
    { "name": "simdjson", "version": "4.6.4" }
  ]
}
