{
  "$schema": "../../schemas/tool.schema.json",
  "schemaVersion": 1,
  "id": "rawframe.tool.evidence",
  "displayName": "Rawframe Evidence",
  "owner": "rawframe.build_engineering",
  "purpose": "Validate repository authority, dependency identity, offline inputs, and deterministic architecture diagnostics.",
  "stability": "internal",
  "implementation": {
    "language": "cpp",
    "dialect": "c++23",
    "buildSystem": "cmake",
    "cmakeTarget": "rawframe_tool_rf_evidence",
    "entryPoints": [
      "audit_paths",
      "audit_shipping_closure",
      "canonicalize_record",
      "explain_dependency",
      "get_blob",
      "graph_repository",
      "inspect_source_ownership",
      "put_blob",
      "review_licenses",
      "validate_record",
      "validate_repository",
      "verify_blob",
      "verify_offline"
    ],
    "exceptions": "disabled",
    "rtti": "disabled"
  },
  "availability": {
    "platforms": [
      "linux",
      "windows"
    ],
    "architectures": [
      "x86_64"
    ]
  },
  "dependencies": {
    "tools": [],
    "modules": [],
    "thirdParty": [
      "library.openssl",
      "library.simdjson"
    ],
    "managedTools": [
      "tool.jsonschema_oracle"
    ]
  },
  "capabilities": {
    "filesystemReadRoots": [
      "out",
      "repository",
      "schemas",
      "third_party",
      "tools"
    ],
    "filesystemWriteRoots": [
      "out/evidence/v1/blobs",
      "out/reports/task-0001"
    ],
    "network": "denied",
    "credentials": "none",
    "runnerControl": false,
    "baselinePromotion": false
  },
  "outputs": [
    {
      "role": "diagnostic_report",
      "root": "out/reports/task-0001"
    },
    {
      "role": "evidence_blob_store",
      "root": "out/evidence/v1/blobs"
    }
  ],
  "distribution": {
    "repositoryOnly": true,
    "shippingClosure": "forbidden",
    "sdkExposure": "forbidden",
    "targetRoot": "forbidden"
  },
  "contracts": [
    "adr.0022",
    "spec.0001",
    "spec.0002",
    "spec.0017",
    "std.0002",
    "std.0004"
  ],
  "verification": [
    "architecture",
    "determinism",
    "integration",
    "platform",
    "security",
    "semantic",
    "shape",
    "unit"
  ]
}
