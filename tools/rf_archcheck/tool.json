{
  "$schema": "../../schemas/tool.schema.json",
  "schemaVersion": 1,
  "id": "rawframe.tool.archcheck",
  "displayName": "Rawframe Architecture Check",
  "owner": "rawframe.architecture",
  "purpose": "Enforce accepted architecture authorities mechanically over the repository. Every check cites one authority and the tool introduces no rule of its own.",
  "stability": "internal",
  "implementation": {
    "language": "cpp",
    "dialect": "c++23",
    "buildSystem": "cmake",
    "cmakeTarget": "rawframe_tool_rf_archcheck",
    "entryPoints": [
      "check_repository",
      "explain_rule",
      "list_rules"
    ],
    "exceptions": "disabled",
    "rtti": "disabled"
  },
  "availability": {
    "platforms": [
      "linux",
      "windows"
    ],
    "architectures": [
      "x86_64"
    ]
  },
  "dependencies": {
    "tools": [],
    "modules": [],
    "thirdParty": [
      "library.simdjson"
    ],
    "managedTools": []
  },
  "capabilities": {
    "filesystemReadRoots": [
      "repository",
      "schemas",
      "third_party",
      "tools"
    ],
    "filesystemWriteRoots": [
      "out/reports/archcheck"
    ],
    "network": "denied",
    "credentials": "none",
    "runnerControl": false,
    "baselinePromotion": false
  },
  "outputs": [
    {
      "role": "findings_report",
      "root": "out/reports/archcheck"
    }
  ],
  "distribution": {
    "repositoryOnly": true,
    "shippingClosure": "forbidden",
    "sdkExposure": "forbidden",
    "targetRoot": "forbidden"
  },
  "contracts": [
    "adr.0002",
    "adr.0004",
    "adr.0005",
    "adr.0008",
    "adr.0012",
    "adr.0022",
    "adr.0068",
    "adr.0071",
    "adr.0077",
    "spec.0001",
    "spec.0002",
    "spec.0003",
    "spec.0007",
    "spec.0012",
    "spec.0017",
    "spec.0044"
  ],
  "verification": [
    "architecture",
    "determinism",
    "integration",
    "platform",
    "security",
    "semantic",
    "shape",
    "unit"
  ]
}
