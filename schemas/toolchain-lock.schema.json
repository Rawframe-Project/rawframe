{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rawframe.net/toolchain-lock.schema.json",
  "title": "Rawframe toolchain lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "lockVersion", "bootstrap", "managedTools", "compilers", "installedSdks", "vcpkg"],
  "properties": {
    "$schema": { "const": "../schemas/toolchain-lock.schema.json" },
    "schemaVersion": { "const": 1 },
    "lockVersion": { "type": "integer", "minimum": 1 },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumCMakeVersion", "verifierContractVersion", "verifierArtifactIds", "transportExecutables"],
      "properties": {
        "minimumCMakeVersion": { "$ref": "#/$defs/version" },
        "verifierContractVersion": { "const": 1 },
        "verifierArtifactIds": { "$ref": "#/$defs/idSet" },
        "transportExecutables": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/bootstrapTransport" }
        }
      }
    },
    "managedTools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "artifactIds", "licenseExpression"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "version": { "$ref": "#/$defs/version" },
          "artifactIds": { "$ref": "#/$defs/idSet" },
          "licenseExpression": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "compilers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/installedRequirement" }
    },
    "installedSdks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/installedRequirement" }
    },
    "vcpkg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolId", "configurationPolicyVersion"],
      "properties": {
        "toolId": { "$ref": "#/$defs/id" },
        "configurationPolicyVersion": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "idSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "installedRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "families", "minimumVersion", "maximumVersionExclusive", "probeId", "capabilities", "redistributable"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "families": { "$ref": "#/$defs/idSet" },
        "minimumVersion": { "$ref": "#/$defs/version" },
        "maximumVersionExclusive": { "$ref": "#/$defs/version" },
        "probeId": { "$ref": "#/$defs/id" },
        "capabilities": { "$ref": "#/$defs/idSet" },
        "redistributable": { "type": "boolean" },
        "verificationExecutables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/installedExecutable" }
        }
      }
    },
    "installedExecutable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "absolutePath", "version", "byteSize", "binarySha256", "capability"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "absolutePath": { "type": "string", "minLength": 1, "maxLength": 260 },
        "version": { "$ref": "#/$defs/version" },
        "byteSize": { "type": "integer", "minimum": 1 },
        "binarySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "capability": { "$ref": "#/$defs/id" }
      }
    },
    "bootstrapTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "absolutePath", "version", "byteSize", "binarySha256", "packageIdentity"],
      "properties": {
        "hostId": { "enum": ["windows-x86_64", "linux-x86_64"] },
        "absolutePath": { "type": "string", "minLength": 1, "maxLength": 260 },
        "version": { "$ref": "#/$defs/version" },
        "byteSize": { "type": "integer", "minimum": 1 },
        "binarySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "packageIdentity": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
