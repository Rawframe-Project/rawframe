{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rawframe.net/dependency-catalog.schema.json",
  "title": "Rawframe third-party dependency catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "entries"],
  "properties": {
    "$schema": { "const": "../schemas/dependency-catalog.schema.json" },
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "purpose",
        "owners",
        "acquisitionClass",
        "provider",
        "allowedUse",
        "license",
        "isolation",
        "security",
        "stability",
        "removalOwner"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "purpose": { "type": "string", "minLength": 20, "maxLength": 240 },
        "owners": {
          "type": "object",
          "additionalProperties": false,
          "required": ["architecture", "security", "updates"],
          "properties": {
            "architecture": { "$ref": "#/$defs/id" },
            "security": { "$ref": "#/$defs/id" },
            "updates": { "$ref": "#/$defs/id" }
          }
        },
        "acquisitionClass": {
          "enum": [
            "registry_source",
            "vendored_source",
            "verified_artifact",
            "installed_sdk",
            "external_product"
          ]
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "reference"],
          "properties": {
            "type": {
              "enum": ["vcpkg", "vendor_origin", "artifact_lock", "installed_sdk", "external_product"]
            },
            "reference": { "$ref": "#/$defs/id" }
          }
        },
        "allowedUse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contexts", "platformFamilies"],
          "properties": {
            "contexts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["client", "server", "editor", "tool", "sdk"] }
            },
            "platformFamilies": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["any", "windows", "linux"] }
            }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdxExpression", "noticeRequired", "redistribution", "approval"],
          "properties": {
            "spdxExpression": { "type": "string", "minLength": 1, "maxLength": 200 },
            "noticeRequired": { "type": "boolean" },
            "redistribution": { "enum": ["allowed", "conditional", "forbidden"] },
            "approval": { "enum": ["approved", "restricted", "rejected"] }
          }
        },
        "isolation": {
          "enum": ["adapter_only", "private_implementation", "tool_only", "sdk_allowed"]
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": ["advisoryPolicy", "exceptionReferences"],
          "properties": {
            "advisoryPolicy": { "enum": ["deny_known", "review_required", "vendor_managed"] },
            "exceptionReferences": { "$ref": "#/$defs/idSet" }
          }
        },
        "stability": { "enum": ["internal", "experimental", "stable"] },
        "removalOwner": { "$ref": "#/$defs/id" }
      }
    }
  }
}
