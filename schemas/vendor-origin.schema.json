{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rawframe.dev/vendor-origin.schema.json",
  "title": "Rawframe vendored source origin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "catalogId",
    "upstreamProject",
    "version",
    "revision",
    "sourceUrl",
    "sha256",
    "licenseReference",
    "importedPaths",
    "importProcedure",
    "patches"
  ],
  "properties": {
    "$schema": { "type": "string", "pattern": "^(?:\\.\\./)+schemas/vendor-origin\\.schema\\.json$" },
    "schemaVersion": { "const": 1 },
    "catalogId": { "$ref": "#/$defs/id" },
    "upstreamProject": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "revision": { "type": "string", "minLength": 7, "maxLength": 200 },
    "sourceUrl": { "type": "string", "format": "uri" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "licenseReference": { "$ref": "#/$defs/id" },
    "importedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "importProcedure": { "$ref": "#/$defs/id" },
    "patches": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose", "owner", "upstreamReference", "removalCondition"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "purpose": { "type": "string", "minLength": 10, "maxLength": 240 },
          "owner": { "$ref": "#/$defs/id" },
          "upstreamReference": { "type": "string", "maxLength": 300 },
          "removalCondition": { "type": "string", "minLength": 10, "maxLength": 240 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-z0-9_][a-z0-9_./-]*$"
    }
  }
}
