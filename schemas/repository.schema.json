{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rawframe.net/repository.schema.json",
  "title": "Rawframe repository index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "modules",
    "targets",
    "platforms",
    "configurations",
    "instrumentations",
    "packagingPolicies",
    "profiles",
    "tools",
    "evidenceIndex"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/repository.schema.json"
    },
    "schemaVersion": {
      "const": 4
    },
    "modules": {
      "$ref": "#/$defs/pathSet"
    },
    "targets": {
      "$ref": "#/$defs/pathSet"
    },
    "platforms": {
      "$ref": "#/$defs/pathSet"
    },
    "configurations": {
      "$ref": "#/$defs/pathSet"
    },
    "instrumentations": {
      "$ref": "#/$defs/pathSet"
    },
    "packagingPolicies": {
      "$ref": "#/$defs/pathSet"
    },
    "profiles": {
      "$ref": "#/$defs/pathSet"
    },
    "tools": {
      "$ref": "#/$defs/pathSet"
    },
    "evidenceIndex": {
      "description": "The one registered index of maintained evidence authorities. SPEC-0017 admits either an evidenceAuthorities membership class here or one registered index, and forbids filesystem scanning in both. A single path is used so that this file does not grow once per registry, policy, and later baseline: the index absorbs that detail, exactly as one tool manifest absorbs a tool's own.",
      "$ref": "#/$defs/repositoryPath"
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-z0-9_][a-z0-9_./-]*$"
    },
    "pathSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    }
  }
}
