    file(REAL_PATH "${temporary}" temporary_real)
    foreach(required_root IN LISTS expected_roots)
        if(NOT EXISTS "${temporary}/${required_root}")
            file(REMOVE_RECURSE "${temporary}")
            rf_bootstrap_fail("RF1277" "multi-root extraction omitted a locked root")
        endif()
    endforeach()
    file(GLOB_RECURSE extracted_entries LIST_DIRECTORIES TRUE "${temporary}/*")
    foreach(extracted_entry IN LISTS extracted_entries)
        file(REAL_PATH "${extracted_entry}" extracted_real)
        cmake_path(IS_PREFIX temporary_real "${extracted_real}" NORMALIZE remains_owned)
        if(NOT remains_owned)
